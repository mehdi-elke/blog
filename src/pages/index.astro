---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
	return date.toLocaleDateString('fr-FR', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});
}
---

<BaseLayout title="Évaluer, Invalider, Fiabiliser.">
	<section class="mb-20">
		<h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-4 leading-none uppercase">
			FAILSAFE. <br/>
			<span class="text-cobalt">Évaluer, Invalider, Fiabiliser.</span>
		</h1>
		<p class="text-lg md:text-xl text-slate-600 max-w-prose leading-relaxed">
			Un espace dédié à l'ingénierie de la fiabilité pour les systèmes IA et RAG.
			Mettre à l'épreuve les modèles pour garantir leur intégrité technique.
		</p>
	</section>

	<section>
		<h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8 border-b border-slate-100 pb-2">
			Articles récents
		</h2>
		<ul class="space-y-12">
			{posts.length > 0 ? (
				posts.map((post) => (
					<li class="group">
						<a href={`${base}/${post.id}/`} class="block">
							<div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-2">
								<h3 class="text-2xl font-bold group-hover:text-cobalt transition-colors tracking-tight">
									{post.data.title}
								</h3>
								<time class="text-sm font-mono text-slate-400 shrink-0">
									{formatDate(post.data.pubDate)}
								</time>
							</div>
							<p class="text-slate-500 line-clamp-2 text-lg">
								{post.data.description}
							</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{post.data.tags?.map(tag => (
									<span class="text-[10px] uppercase tracking-wider font-bold px-2 py-1 bg-slate-100 text-slate-500 rounded">
										{tag}
									</span>
								))}
							</div>
						</a>
					</li>
				))
			) : (
				<li class="text-slate-500 italic text-center py-12 border-2 border-dashed border-slate-100 rounded-lg">
					Aucun article publié pour le moment.
				</li>
			)}
		</ul>
	</section>
</BaseLayout>
