---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
	return date.toLocaleDateString('fr-FR', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});
}
---

<BaseLayout title="Évaluer, Invalider, Fiabiliser.">
	<section class="mb-20">
		<h1 class="text-4xl font-extrabold tracking-tighter mb-4 leading-none uppercase">
			FAILSAFE. <br/>
			<span class="text-cobalt">Évaluer, Invalider, Fiabiliser.</span>
		</h1>
		<p class="text-lg text-slate-600 max-w-prose">
			Un espace dédié à l'ingénierie de la fiabilité pour les systèmes IA et RAG.
			Mettre à l'épreuve les modèles pour garantir leur intégrité.
		</p>
	</section>

	<section>
		<h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8 border-b border-slate-100 pb-2">
			Articles récents
		</h2>
		<ul class="space-y-6">
			{posts.length > 0 ? (
				posts.map((post) => (
					<li class="group">
						<a href={`${base}/blog/${post.id}`} class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8">
							<time class="text-xs font-mono text-slate-400 shrink-0">
								{formatDate(post.data.pubDate)}
							</time>
							<h3 class="text-lg font-medium group-hover:text-cobalt transition-colors decoration-cobalt/30 underline-offset-4 group-hover:underline">
								{post.data.title}
							</h3>
						</a>
					</li>
				))
			) : (
				<li class="text-slate-500 italic">Aucun article publié pour le moment.</li>
			)}
		</ul>
	</section>
</BaseLayout>
