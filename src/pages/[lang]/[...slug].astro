---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog');
	return blogEntries.map(entry => {
    const [lang, ...slugParts] = entry.id.split('/');
    return {
      params: { lang, slug: slugParts.join('/') || undefined },
      props: { entry, lang },
    };
  });
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(lang as 'fr' | 'en');

function formatDate(date: Date) {
	return date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

function getReadingTime(content: string) {
	const wordsPerMinute = 180;
	const numberOfWords = content.split(/\s/g).length;
	return Math.ceil(numberOfWords / wordsPerMinute);
}

const readingTime = getReadingTime(entry.body || "");
const base = import.meta.env.BASE_URL;
const image = entry.data.image;
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={typeof image === 'string' ? image : image?.src}>
	<article class="max-w-none">
		<header class="mb-12">
			<div class="flex items-center gap-4 text-sm font-mono text-muted mb-4">
				<time>{formatDate(entry.data.pubDate)}</time>
				<span>•</span>
				<span>{readingTime} {t('post.readingTime')}</span>
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter uppercase mb-8 leading-[1.1]">
				{entry.data.title}
			</h1>

			{image && (
				<div class="mb-12">
					{typeof image === 'string' ? (
						<img 
							src={image.startsWith('/') ? `${base}${image}`.replace(/\/+/g, '/') : image} 
							alt={entry.data.title} 
							class="w-full aspect-video object-cover border border-border-main"
						/>
					) : (
						<Image 
							src={image} 
							alt={entry.data.title} 
							class="w-full aspect-video object-cover border border-border-main"
						/>
					)}
				</div>
			)}

			<p class="text-xl md:text-2xl text-muted italic border-l-4 border-cobalt pl-6 py-2 leading-relaxed">
				{entry.data.description}
			</p>
			
			<div class="mt-8 flex flex-wrap gap-2">
				{entry.data.tags?.map(tag => (
					<span class="text-xs uppercase tracking-widest font-bold px-3 py-1 bg-muted/10 text-muted rounded-full">
						#{tag}
					</span>
				))}
			</div>
		</header>

		<div class="prose prose-slate dark:prose-invert prose-lg max-w-none text-noir
			prose-headings:tracking-tighter prose-headings:uppercase prose-headings:font-extrabold prose-headings:text-noir
			prose-p:text-noir
			prose-strong:text-noir
			prose-h2:border-b prose-h2:border-border-main prose-h2:pb-2 prose-h2:mt-16
			prose-blockquote:border-l-cobalt prose-blockquote:bg-muted/5 prose-blockquote:not-italic prose-blockquote:font-medium prose-blockquote:text-noir
			prose-pre:rounded-none prose-pre:border prose-pre:border-border-main
			prose-a:text-cobalt prose-a:font-bold prose-a:no-underline hover:prose-a:underline">
			<Content />
		</div>

		<footer class="mt-24 pt-12 border-t border-border-main">
			<a href={`${base}/${lang}/`} class="group inline-flex items-center text-cobalt font-bold uppercase tracking-widest text-sm">
				<span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> 
				{t('post.back')}
			</a>
		</footer>
	</article>
</BaseLayout>
